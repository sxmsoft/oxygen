{
  "manifest_version": 3,
  "name": "Oxygen",
  "short_name": "Oxygen",
  "version": "0.2.0",
  "version_name": "0.2.0-alpha.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "omnibox": {
    "keyword": "ox"
  },
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "__MSG_cmdPalette__"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSidePanel__"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "management",
    "tabs",
    "tabGroups",
    "sessions",
    "history",
    "bookmarks",
    "favicon",
    "sidePanel",
    "scripting",
    "alarms",
    "webNavigation",
    "search"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
