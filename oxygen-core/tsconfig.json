{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "../sdk/src/**/*.ts",
    "./src/**/*.ts",
    "./tests/**/*.ts",
    "../modules/core-theme-obsidian/src/**/*.ts",
    "../extension/src/logic/**/*.ts",
    "../extension/src/modules/**/*.ts"
  ]
}
